    {
      "sloka": 10,
      "caption_anchor": "intake/D035/photo-captions.txt#029",
      "caption_sha256": "351028b8a0657fa45cbbd051ffb1df44cc3f76ac89e170501f08a44d7f58e948",
      "caption_text": "Bhattadiri says that Rama, is to teach Mankind that excessive attachement to beings or things will lead only to sacrifice and suffering of innocent souls. He requests Bhagwan who taught this truth to the world through his Rama avathar to cure the world of all afflictions.",
