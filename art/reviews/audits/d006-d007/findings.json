  "findings": {
    "F-D006-STYLE-01": {
      "chapter": 6,
      "scope": "all inspected published D006 versions",
      "category": "style",
      "severity": "moderate",
      "confidence": "high",
      "confidence_value": 0.9,
      "subject_location": "global image treatment; normalized bbox [0,0,1,1]",
      "observed": "The set has dense engraved/granular texture and high-contrast bright gold ornament highlights compared with the series bible\u2019s broad matte mineral fields and painted ochre. Several scenes also use heavy architectural framing, whereas the bible calls for full-bleed composition. This is rendering drift, not an anatomy defect.",
      "expected_basis": "art/bible/series.json style description and frame_continuity: firm contours, broad matte fields, painted ochre instead of metallic gold, full bleed.",
      "repair_direction": "If this batch is brought to production, regenerate affected scenes with the D001 matte references and explicitly suppress reflective gold, texture overlays, and heavy outer frames."
    },
    "F-D006-S007-V001-01": {
      "chapter": 6,
      "sloka": 7,
      "category": "scene fidelity",
      "severity": "moderate",
      "confidence": "high",
      "confidence_value": 0.9,
      "subject_location": "Virat garment/back, central figure; bbox [0.38,0.36,0.24,0.48]",
      "observed": "The visible alternate v001 lacks a clear Adharma/back mapping called for by the scene plan; the selected v002 adds a dark patterned back-facing shawl. Anatomy in v001 is otherwise coherent.",
      "expected_basis": "art/plans/d006.json S007 scene brief requires Adharma mapped to the back and an opaque twilight garment.",
      "repair_direction": "Keep v002 selected; v001 should remain visibly marked as the superseded scene-incomplete alternate."
    },
    "F-D006-S008-DETAIL-01": {
      "chapter": 6,
      "sloka": 8,
      "category": "inspection limitation",
      "severity": "low",
      "confidence": "high",
      "confidence_value": 0.95,
      "subject_location": "four small human groups surrounding Virat; distributed, approx bbox [0.02,0.17,0.96,0.72]",
      "observed": "At full image size, group figures are small; gross two-arm silhouettes and separation are visible, but fingers and some shoulder-to-wrist details are too small to clear individually. No extra or fused limb is evident at this resolution.",
      "expected_basis": "art/plans/d006.json S008: four equally dignified ordinary-human groups with two arms each.",
      "repair_direction": "For future publication approval, inspect a higher-resolution crop of each group; do not infer a pass for finger anatomy from the full-frame view."
    },
    "F-D007-STYLE-01": {
      "chapter": 7,
      "scope": "all inspected published D007 versions",
      "category": "style",
      "severity": "moderate",
      "confidence": "high",
      "confidence_value": 0.95,
      "subject_location": "global image treatment; normalized bbox [0,0,1,1]",
      "observed": "Across the D007 set, dense surface texture and bright raised/reflective-looking gold ornament depart from the series bible\u2019s matte mineral fields and painted ochre. This matches the existing D007 review note that rendering is more ornate and textured than the D001 anchors; this audit freshly observed the same issue.",
      "expected_basis": "art/bible/series.json style/global_avoid; art/plans/d007.json scenes explicitly avoid glossy surfaces and metallic reflections.",
      "repair_direction": "Regenerate candidates against D001 S004/S008 matte rendering references, requesting broad flat color fields and nonreflective ochre ornament."
    },
    "F-D007-S004-SCALE-01": {
      "chapter": 7,
      "sloka": 4,
      "category": "inspection limitation",
      "severity": "low",
      "confidence": "high",
      "confidence_value": 0.95,
      "subject_location": "Brahma in lower-left foreground; bbox approx [0.01,0.78,0.09,0.20]",
      "observed": "Brahma is deliberately very small in the wide landscape. The three visible heads are distinguishable, but the arms/hands are too small to verify four-arm anatomy at image resolution. No defect is asserted.",
      "expected_basis": "art/plans/d007.json S004 requires a four-armed Brahma with three front-visible faces from four heads total.",
      "repair_direction": "For approval review, inspect a readable crop or revise framing to make the witness large enough for arm verification."
    }
  },
